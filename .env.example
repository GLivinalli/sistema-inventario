# Copie este arquivo para ".env" e ajuste os valores antes de rodar o servidor.

# Porta do servidor
PORT=3000

# Chave usada para autenticar operações de escrita (POST) e exclusão (DELETE).
# Troque por um valor forte e único. Ex: use `openssl rand -hex 24` para gerar um.
API_KEY=troque-esta-chave-para-algo-forte-e-unico
